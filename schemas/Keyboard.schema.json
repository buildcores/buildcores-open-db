{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": ["object", "null"],
  "title": "Keyboard Schema",
  "description": "Schema for Keyboard components",
  "required": ["metadata"],
  "properties": {
    "opendb_id": {
      "type": ["string", "null"],
      "description": "Unique identifier for the document (UUID v4)"
    },
    "switch": {
      "description": "The specific switch model (e.g., Cherry MX Red, Gateron Brown)",
      "type": ["string", "null"]
    },
    "switch_type": {
      "description": "The behavior of the switches",
      "type": ["string", "null"],
      "enum": ["Linear", "Tactile", "Clicky", "Magnetic", "Membrane", null]
    },
    "size": {
      "description": "The physical layout size of the keyboard",
      "type": ["string", "null"],
      "enum": [
        "Full Size",
        "96%",
        "TKL (80%)",
        "75%",
        "70%",
        "65%",
        "60%",
        "40%",
        "Numpad",
        "Other",
        null
      ]
    },
    "size_other": {
      "description": "Custom size if not in the standard enum",
      "type": ["string", "null"]
    },
    "hot_swappable": {
      "description": "Whether switches can be replaced without soldering",
      "type": ["boolean", "null"]
    },
    "backlighting": {
      "description": "The type of lighting on the keyboard",
      "type": ["string", "null"],
      "enum": ["RGB", "Single Color", "None", null]
    },
    "lighting": {
      "description": "Lighting capabilities for this product. Use RGB for non-addressable RGB, ARGB for addressable RGB, Multicolor for non-RGB multi-color lighting, Fixed for a single fixed lighting color, None when the product has no lighting, Display for configurable displays, and Fixed Color Display for displays limited to fixed colors such as black and white.",
      "type": ["array", "null"],
      "items": {
        "type": "string",
        "enum": ["RGB", "ARGB", "Multicolor", "Fixed", "None", "Display", "Fixed Color Display"]
      }
    },
    "features": {
      "description": "Notable keyboard features (e.g., knob, low profile, split, screen, silent)",
      "type": ["array", "null"],
      "items": {
        "type": "string",
        "enum": ["Knob", "Low Profile", "Split", "Screen", "Silent"]
      }
    },
    "connectivity": {
      "description": "How the keyboard connects to the computer",
      "type": ["array", "null"],
      "items": {
        "type": "string",
        "enum": ["Wired", "Wired USB-A", "Wired USB-C", "Wireless 2.4GHz", "Bluetooth"]
      }
    },
    "keycap_material": {
      "description": "The material used for the keycaps (e.g., ABS, PBT)",
      "type": ["string", "null"]
    },
    "frame_material": {
      "description": "The material used for the keyboard frame/case",
      "type": ["string", "null"]
    },
    "polling_rate": {
      "description": "The frequency at which the keyboard reports input to the computer in Hz",
      "type": ["number", "null"]
    },
    "battery_capacity": {
      "description": "The capacity of the built-in battery in mAh (for wireless keyboards)",
      "type": ["number", "null"]
    },
    "general_product_information": {
      "type": ["object", "null"],
      "description": "General product information and retailer SKUs",
      "properties": {
        "amazon_sku": {
          "type": ["string", "null"],
          "description": "Amazon product SKU"
        },
        "newegg_sku": {
          "type": ["string", "null"],
          "description": "Newegg product SKU"
        },
        "bestbuy_sku": {
          "type": ["number", "null"],
          "description": "Best Buy product SKU"
        },
        "walmart_sku": {
          "type": ["number", "null"],
          "description": "Walmart product SKU"
        },
        "adorama_sku": {
          "type": ["string", "null"],
          "description": "Adorama product SKU"
        },
        "ibuypower_sku": {
          "type": ["string", "null"],
          "description": "iBuyPower product SKU"
        },
        "hyte_sku": {
          "type": ["string", "null"],
          "description": "HYTE product SKU"
        },
        "lttstore_sku": {
          "type": ["string", "null"],
          "description": "LTTStore product SKU"
        },
        "manufacturer_url": {
          "type": ["string", "null"],
          "description": "Official manufacturer product URL"
        }
      }
    },
    "metadata": {
      "type": ["object", "null"],
      "properties": {
        "name": {
          "description": "Full product name",
          "type": ["string", "null"]
        },
        "manufacturer": {
          "description": "Keyboard manufacturer",
          "type": ["string", "null"]
        },
        "part_numbers": {
          "description": "Array of manufacturer's part numbers/SKUs",
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "series": {
          "description": "Product series name",
          "type": ["string", "null"]
        },
        "variant": {
          "description": "Specific variant in the series",
          "type": ["string", "null"]
        },
        "releaseYear": {
          "description": "Year of release",
          "type": ["number", "null"]
        },
        "last_manually_spec_verified_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "ISO 8601 timestamp of when the part specs were last manually verified by a human"
        }
      },
      "required": ["name"]
    },
    "identifiers": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Monotonically increasing identity snapshot version"
        },
        "identifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["upc", "ean", "gtin", "mpn"]
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "region": {
                "default": "all",
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["type", "value", "region"],
            "additionalProperties": false
          },
          "description": "Canonical product identifiers"
        },
        "retailer_listings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "channel": {
                "type": "string",
                "minLength": 1
              },
              "source_product_id": {
                "type": "string",
                "minLength": 1
              },
              "pricing_enabled": {
                "type": "boolean"
              },
              "excluded_source_offer_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "verified": {
                "type": "boolean"
              }
            },
            "required": ["source", "channel", "source_product_id", "pricing_enabled", "verified"],
            "additionalProperties": false
          },
          "description": "Canonical retailer product listings used for pricing"
        }
      },
      "required": ["version", "identifiers", "retailer_listings"],
      "additionalProperties": false,
      "description": "Current versioned product identity snapshot used for retailer and pricing matching"
    }
  }
}
