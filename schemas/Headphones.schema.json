{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": ["object", "null"],
  "title": "Headphones Schema",
  "description": "Schema for Headphones components",
  "required": ["metadata"],
  "properties": {
    "opendb_id": {
      "type": ["string", "null"],
      "description": "Unique identifier for the document (UUID v4)"
    },
    "driver_size": {
      "description": "Driver size in millimeters",
      "type": ["number", "null"]
    },
    "frequency_response_low": {
      "description": "Low-end frequency response in Hz",
      "type": ["number", "null"]
    },
    "frequency_response_high": {
      "description": "High-end frequency response in kHz",
      "type": ["number", "null"]
    },
    "headphone_type": {
      "description": "Acoustic design type",
      "type": ["string", "null"],
      "enum": ["Open-Back", "Closed-Back", "Semi-Open", null]
    },
    "ear_cup_type": {
      "description": "Ear cup fit type",
      "type": ["string", "null"],
      "enum": ["Over-Ear", "On-Ear", "In-Ear", "Earbuds", null]
    },
    "weight": {
      "description": "Headphone weight in grams",
      "type": ["number", "null"]
    },
    "frame_material": {
      "description": "Primary frame/chassis material",
      "type": ["string", "null"],
      "enum": ["Plastic", "Aluminum", "Steel", "Carbon Fiber", "Mixed", null]
    },
    "ear_pad_material": {
      "description": "Ear pad materials",
      "type": ["array", "null"],
      "items": {
        "type": "string",
        "enum": ["Leather", "Leatherette", "Velour", "Fabric", "Memory Foam", "Silicone"]
      }
    },
    "connection_types": {
      "description": "Supported connection types",
      "type": ["array", "null"],
      "items": {
        "type": "string",
        "enum": [
          "Wired 3.5mm",
          "Wired 6.35mm",
          "Wired 2.5mm Balanced",
          "Wired 4.4mm Balanced",
          "USB-C",
          "USB-A",
          "Bluetooth",
          "Wireless 2.4GHz",
          "Wireless RF"
        ]
      }
    },
    "battery_life": {
      "description": "Battery life in hours",
      "type": ["number", "null"]
    },
    "bluetooth_version": {
      "description": "Bluetooth version (e.g., 5.3)",
      "type": ["string", "null"]
    },
    "charging_port": {
      "description": "Charging interface type",
      "type": ["string", "null"],
      "enum": ["USB-C", "Micro-USB", "Lightning", "Wireless Qi", null]
    },
    "wireless_range": {
      "description": "Wireless range in feet/meters",
      "type": ["number", "null"]
    },
    "latency": {
      "description": "Wireless latency in milliseconds",
      "type": ["number", "null"]
    },
    "has_microphone": {
      "description": "Whether the headphones include a microphone",
      "type": ["boolean", "null"]
    },
    "microphone_type": {
      "description": "Microphone implementation type",
      "type": ["string", "null"],
      "enum": ["Built-In", "Detachable Boom", "Inline", "None", null]
    },
    "noise_cancellation_mic": {
      "description": "Whether ENC/noise-cancelling microphone is supported",
      "type": ["boolean", "null"]
    },
    "features": {
      "description": "Additional active product features",
      "type": ["array", "null"],
      "items": {
        "type": "string",
        "enum": [
          "ANC",
          "Ambient Mode",
          "Spatial Audio",
          "Dolby Atmos",
          "Multi-Device Pairing",
          "App Support",
          "EQ Customization",
          "Foldable"
        ]
      }
    },
    "use_cases": {
      "description": "Primary intended usage categories",
      "type": ["array", "null"],
      "items": {
        "type": "string",
        "enum": ["Gaming", "Audiophile", "Casual"]
      }
    },
    "platforms": {
      "description": "Platform compatibility buckets",
      "type": ["array", "null"],
      "items": {
        "type": "string",
        "enum": ["PC", "Console", "Mobile"]
      }
    },
    "lighting": {
      "description": "Lighting capabilities for this product. Use RGB for non-addressable RGB, ARGB for addressable RGB, Multicolor for non-RGB multi-color lighting, Fixed for a single fixed lighting color, None when the product has no lighting, Display for configurable displays, and Fixed Color Display for displays limited to fixed colors such as black and white.",
      "type": ["array", "null"],
      "items": {
        "type": "string",
        "enum": ["RGB", "ARGB", "Multicolor", "Fixed", "None", "Display", "Fixed Color Display"]
      }
    },
    "general_product_information": {
      "type": ["object", "null"],
      "description": "General product information and retailer SKUs",
      "properties": {
        "amazon_sku": {
          "type": ["string", "null"],
          "description": "Amazon product SKU"
        },
        "newegg_sku": {
          "type": ["string", "null"],
          "description": "Newegg product SKU"
        },
        "bestbuy_sku": {
          "type": ["number", "null"],
          "description": "Best Buy product SKU"
        },
        "walmart_sku": {
          "type": ["number", "null"],
          "description": "Walmart product SKU"
        },
        "adorama_sku": {
          "type": ["string", "null"],
          "description": "Adorama product SKU"
        },
        "ibuypower_sku": {
          "type": ["string", "null"],
          "description": "iBuyPower product SKU"
        },
        "hyte_sku": {
          "type": ["string", "null"],
          "description": "HYTE product SKU"
        },
        "lttstore_sku": {
          "type": ["string", "null"],
          "description": "LTTStore product SKU"
        },
        "manufacturer_url": {
          "type": ["string", "null"],
          "description": "Official manufacturer product URL"
        }
      }
    },
    "metadata": {
      "type": ["object", "null"],
      "properties": {
        "name": {
          "description": "Full product name",
          "type": ["string", "null"]
        },
        "manufacturer": {
          "description": "Headphones manufacturer",
          "type": ["string", "null"]
        },
        "part_numbers": {
          "description": "Array of manufacturer's part numbers/SKUs",
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "series": {
          "description": "Product series name",
          "type": ["string", "null"]
        },
        "variant": {
          "description": "Specific variant in the series",
          "type": ["string", "null"]
        },
        "releaseYear": {
          "description": "Year of release",
          "type": ["number", "null"]
        },
        "last_manually_spec_verified_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "ISO 8601 timestamp of when the part specs were last manually verified by a human"
        }
      },
      "required": ["name"]
    },
    "identifiers": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Monotonically increasing identity snapshot version"
        },
        "identifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["upc", "ean", "gtin", "mpn"]
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "region": {
                "default": "all",
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["type", "value", "region"],
            "additionalProperties": false
          },
          "description": "Canonical product identifiers"
        },
        "retailer_listings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "channel": {
                "type": "string",
                "minLength": 1
              },
              "source_product_id": {
                "type": "string",
                "minLength": 1
              },
              "pricing_enabled": {
                "type": "boolean"
              },
              "excluded_source_offer_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "verified": {
                "type": "boolean"
              }
            },
            "required": ["source", "channel", "source_product_id", "pricing_enabled", "verified"],
            "additionalProperties": false
          },
          "description": "Canonical retailer product listings used for pricing"
        }
      },
      "required": ["version", "identifiers", "retailer_listings"],
      "additionalProperties": false,
      "description": "Current versioned product identity snapshot used for retailer and pricing matching"
    }
  }
}
