{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": ["object", "null"],
  "title": "Prebuilt Desktop Schema",
  "description": "Schema for Prebuilt Desktop components",
  "required": ["metadata"],
  "properties": {
    "opendb_id": {
      "type": ["string", "null"],
      "description": "Unique identifier for the document (UUID v4)"
    },
    "weight": {
      "description": "Product weight in grams for one complete, usable unit of this exact variant. Exclude retail packaging, shipping materials, multipack totals, and load capacity. Leave unset when the product is digital, the weight is unknown, or the source does not clearly identify product weight.",
      "type": ["number", "null"],
      "exclusiveMinimum": 0
    },
    "display_outputs": {
      "description": "Confirmed video output groups that send video from this exact source product to an external display. Do not enter input-only ports, ordinary USB data ports, or raw legacy connector text. Legacy video-port counts are migration candidates, not automatic evidence.",
      "minItems": 1,
      "type": ["array", "null"],
      "items": {
        "description": "One group of physically identical video-capable ports on the exact product configuration.",
        "type": "object",
        "properties": {
          "id": {
            "description": "Stable system-generated row identifier. It is assigned on save and is not entered by reviewers.",
            "type": ["string", "null"],
            "minLength": 1
          },
          "connector": {
            "description": "Physical connector type for this group of otherwise identical video-capable ports.",
            "type": ["string", "null"],
            "enum": [
              "hdmi",
              "displayport",
              "mini_displayport",
              "usb_c",
              "dvi_d",
              "vga",
              "other",
              null
            ]
          },
          "count": {
            "description": "Number of identical ports in this group; omit when the official count is unknown.",
            "type": ["integer", "null"],
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "version_label": {
            "description": "Manufacturer's exact connector or protocol version label. A version label alone never proves a display mode.",
            "type": ["string", "null"],
            "minLength": 1
          },
          "video_signal": {
            "description": "Confirmed video signal carried by this port group. It must be known before the group is used for compatibility.",
            "type": ["string", "null"],
            "enum": ["hdmi", "displayport", "dvi", "vga", null]
          },
          "transport": {
            "description": "Published native, DisplayPort Alt Mode, Thunderbolt, or USB4 transport for this group.",
            "type": ["string", "null"],
            "enum": ["native", "dp_alt_mode", "thunderbolt", "usb4", null]
          },
          "connector_label": {
            "description": "Manufacturer's connector name; required when connector is other.",
            "type": ["string", "null"],
            "minLength": 1
          },
          "graphics_route": {
            "description": "Published discrete, integrated, or switchable graphics route for an output group; omit rather than guessing.",
            "type": ["string", "null"],
            "enum": ["discrete", "integrated", "switchable", null]
          },
          "mode_claims": {
            "description": "Official resolution-and-refresh claims for this exact port group. Leave unset when unknown; do not infer modes from connector version.",
            "minItems": 1,
            "type": ["array", "null"],
            "items": {
              "description": "One sourced resolution-and-refresh claim for the containing port group.",
              "type": "object",
              "properties": {
                "id": {
                  "description": "Stable system-generated row identifier. It is assigned on save and is not entered by reviewers.",
                  "type": ["string", "null"],
                  "minLength": 1
                },
                "resolution": {
                  "description": "Exact resolution carried by this port for this individual sourced claim.",
                  "type": ["object", "null"],
                  "properties": {
                    "horizontalRes": {
                      "description": "Horizontal pixel count for this exact resolution claim; must be a positive integer.",
                      "type": ["integer", "null"],
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "verticalRes": {
                      "description": "Vertical pixel count for this exact resolution claim; must be a positive integer.",
                      "type": ["integer", "null"],
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["horizontalRes", "verticalRes"]
                },
                "refresh_rate": {
                  "description": "Positive refresh rate in Hz for this exact port-and-resolution claim.",
                  "type": ["number", "null"],
                  "exclusiveMinimum": 0
                },
                "claim": {
                  "description": "Use supported for a listed timing. Use maximum_at_resolution only when an official source states the ceiling.",
                  "type": ["string", "null"],
                  "enum": ["supported", "maximum_at_resolution", null]
                },
                "dsc": {
                  "description": "Whether DSC is explicitly required or explicitly not required for this exact claim.",
                  "type": ["string", "null"],
                  "enum": ["required", "not_required", null]
                },
                "hdr": {
                  "description": "Explicit HDR support condition for this exact claim.",
                  "type": ["string", "null"],
                  "enum": ["supported", "not_supported", null]
                },
                "conditions": {
                  "description": "Unusual official restrictions for this exact claim. Preserve as source context; do not parse as a compatibility rule.",
                  "type": ["string", "null"],
                  "minLength": 1
                }
              },
              "required": ["resolution", "refresh_rate", "claim"]
            }
          }
        },
        "required": ["connector"]
      }
    },
    "general_product_information": {
      "type": ["object", "null"],
      "description": "General product information and retailer SKUs",
      "properties": {
        "amazon_sku": {
          "type": ["string", "null"],
          "description": "Amazon product SKU"
        },
        "newegg_sku": {
          "type": ["string", "null"],
          "description": "Newegg product SKU"
        },
        "bestbuy_sku": {
          "type": ["number", "null"],
          "description": "Best Buy product SKU"
        },
        "walmart_sku": {
          "type": ["number", "null"],
          "description": "Walmart product SKU"
        },
        "adorama_sku": {
          "type": ["string", "null"],
          "description": "Adorama product SKU"
        },
        "ibuypower_sku": {
          "type": ["string", "null"],
          "description": "iBuyPower product SKU"
        },
        "hyte_sku": {
          "type": ["string", "null"],
          "description": "HYTE product SKU"
        },
        "lttstore_sku": {
          "type": ["string", "null"],
          "description": "LTTStore product SKU"
        },
        "manufacturer_url": {
          "type": ["string", "null"],
          "description": "Official manufacturer product URL"
        }
      }
    },
    "metadata": {
      "type": ["object", "null"],
      "properties": {
        "name": {
          "description": "Full product name",
          "type": ["string", "null"]
        },
        "manufacturer": {
          "description": "Prebuilt Desktop manufacturer",
          "type": ["string", "null"]
        },
        "part_numbers": {
          "description": "Array of manufacturer's part numbers/SKUs",
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "series": {
          "description": "Product series name",
          "type": ["string", "null"]
        },
        "variant": {
          "description": "Specific variant in the series",
          "type": ["string", "null"]
        },
        "releaseYear": {
          "description": "Year of release",
          "type": ["number", "null"]
        },
        "last_manually_spec_verified_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "ISO 8601 timestamp of when the part specs were last manually verified by a human"
        }
      },
      "required": ["name"]
    },
    "identifiers": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Monotonically increasing identity snapshot version"
        },
        "identifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["upc", "ean", "gtin", "mpn"]
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "region": {
                "default": "all",
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["type", "value", "region"],
            "additionalProperties": false
          },
          "description": "Canonical product identifiers"
        },
        "retailer_listings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "channel": {
                "type": "string",
                "minLength": 1
              },
              "source_product_id": {
                "type": "string",
                "minLength": 1
              },
              "pricing_enabled": {
                "type": "boolean"
              },
              "excluded_source_offer_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "verified": {
                "type": "boolean"
              }
            },
            "required": ["source", "channel", "source_product_id", "pricing_enabled", "verified"],
            "additionalProperties": false
          },
          "description": "Canonical retailer product listings used for pricing"
        }
      },
      "required": ["version", "identifiers", "retailer_listings"],
      "additionalProperties": false,
      "description": "Current versioned product identity snapshot used for retailer and pricing matching"
    }
  }
}
