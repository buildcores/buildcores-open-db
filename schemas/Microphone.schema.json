{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": ["object", "null"],
  "title": "Microphone Schema",
  "description": "Schema for Microphone components",
  "required": ["metadata"],
  "properties": {
    "opendb_id": {
      "type": ["string", "null"],
      "description": "Unique identifier for the document (UUID v4)"
    },
    "connectivity_type": {
      "description": "Microphone connectivity options (USB-A, USB-C, XLR, 3.5mm, Bluetooth, 2.4GHz, Lightning)",
      "type": ["array", "null"],
      "items": {
        "type": "string",
        "enum": ["USB-A", "USB-C", "XLR", "3.5mm Jack", "Bluetooth", "Wireless 2.4GHz", "Lightning"]
      }
    },
    "polar_pattern": {
      "description": "Supported polar patterns (cardioid, omnidirectional, bidirectional, multi-pattern)",
      "type": ["array", "null"],
      "items": {
        "type": "string",
        "enum": ["Cardioid", "Omnidirectional", "Bidirectional", "Multi-Pattern"]
      }
    },
    "features": {
      "description": "Features of the microphone (mute button, gain control, rgb lighting)",
      "type": ["array", "null"],
      "items": {
        "type": "string",
        "enum": ["Mute Button", "Gain Control", "RGB Lighting"]
      }
    },
    "lighting": {
      "description": "Lighting capabilities for this product. Use RGB for non-addressable RGB, ARGB for addressable RGB, Multicolor for non-RGB multi-color lighting, Fixed for a single fixed lighting color, None when the product has no lighting, Display for configurable displays, and Fixed Color Display for displays limited to fixed colors such as black and white.",
      "type": ["array", "null"],
      "items": {
        "type": "string",
        "enum": ["RGB", "ARGB", "Multicolor", "Fixed", "None", "Display", "Fixed Color Display"]
      }
    },
    "general_product_information": {
      "type": ["object", "null"],
      "description": "General product information and retailer SKUs",
      "properties": {
        "amazon_sku": {
          "type": ["string", "null"],
          "description": "Amazon product SKU"
        },
        "newegg_sku": {
          "type": ["string", "null"],
          "description": "Newegg product SKU"
        },
        "bestbuy_sku": {
          "type": ["number", "null"],
          "description": "Best Buy product SKU"
        },
        "walmart_sku": {
          "type": ["number", "null"],
          "description": "Walmart product SKU"
        },
        "adorama_sku": {
          "type": ["string", "null"],
          "description": "Adorama product SKU"
        },
        "ibuypower_sku": {
          "type": ["string", "null"],
          "description": "iBuyPower product SKU"
        },
        "hyte_sku": {
          "type": ["string", "null"],
          "description": "HYTE product SKU"
        },
        "lttstore_sku": {
          "type": ["string", "null"],
          "description": "LTTStore product SKU"
        },
        "manufacturer_url": {
          "type": ["string", "null"],
          "description": "Official manufacturer product URL"
        }
      }
    },
    "metadata": {
      "type": ["object", "null"],
      "properties": {
        "name": {
          "description": "Full product name",
          "type": ["string", "null"]
        },
        "manufacturer": {
          "description": "Microphone manufacturer",
          "type": ["string", "null"]
        },
        "part_numbers": {
          "description": "Array of manufacturer's part numbers/SKUs",
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "series": {
          "description": "Product series name",
          "type": ["string", "null"]
        },
        "variant": {
          "description": "Specific variant in the series",
          "type": ["string", "null"]
        },
        "releaseYear": {
          "description": "Year of release",
          "type": ["number", "null"]
        },
        "last_manually_spec_verified_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "ISO 8601 timestamp of when the part specs were last manually verified by a human"
        }
      },
      "required": ["name"]
    },
    "identifiers": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Monotonically increasing identity snapshot version"
        },
        "identifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["upc", "ean", "gtin", "mpn"]
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "region": {
                "default": "all",
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["type", "value", "region"],
            "additionalProperties": false
          },
          "description": "Canonical product identifiers"
        },
        "retailer_listings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "channel": {
                "type": "string",
                "minLength": 1
              },
              "source_product_id": {
                "type": "string",
                "minLength": 1
              },
              "pricing_enabled": {
                "type": "boolean"
              },
              "excluded_source_offer_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "verified": {
                "type": "boolean"
              }
            },
            "required": ["source", "channel", "source_product_id", "pricing_enabled", "verified"],
            "additionalProperties": false
          },
          "description": "Canonical retailer product listings used for pricing"
        }
      },
      "required": ["version", "identifiers", "retailer_listings"],
      "additionalProperties": false,
      "description": "Current versioned product identity snapshot used for retailer and pricing matching"
    }
  }
}
