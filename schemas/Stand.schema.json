{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": ["object", "null"],
  "title": "Stand Schema",
  "description": "Schema for Stand components",
  "required": ["metadata"],
  "properties": {
    "opendb_id": {
      "type": ["string", "null"],
      "description": "Unique identifier for the document (UUID v4)"
    },
    "weight": {
      "description": "Product weight in grams for one complete, usable unit of this exact variant. Exclude retail packaging, shipping materials, multipack totals, and load capacity. Leave unset when the product is digital, the weight is unknown, or the source does not clearly identify product weight.",
      "type": ["number", "null"],
      "exclusiveMinimum": 0
    },
    "display_mount_kind": {
      "description": "Whether this exact product is a monitor arm, monitor stand, or wall mount.",
      "type": ["string", "null"],
      "enum": ["monitor_arm", "monitor_stand", "wall_mount", null]
    },
    "display_mount_vesa_patterns": {
      "description": "Published VESA plate patterns supported by this exact stand or arm configuration.",
      "minItems": 1,
      "type": ["array", "null"],
      "items": {
        "description": "Published horizontal and vertical VESA mounting-hole spacing in mm.",
        "type": "object",
        "properties": {
          "width_mm": {
            "description": "Published horizontal VESA mounting-hole spacing in mm; do not infer certification.",
            "type": ["integer", "null"],
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "height_mm": {
            "description": "Published vertical VESA mounting-hole spacing in mm; do not infer certification.",
            "type": ["integer", "null"],
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["width_mm", "height_mm"]
      }
    },
    "min_supported_display_weight_kg": {
      "description": "Published minimum supported display weight in kg for this exact mount configuration.",
      "type": ["number", "null"],
      "exclusiveMinimum": 0
    },
    "max_supported_display_weight_kg": {
      "description": "Published maximum supported display weight in kg for this exact mount configuration.",
      "type": ["number", "null"],
      "exclusiveMinimum": 0
    },
    "supported_display_count": {
      "description": "Published positive number of displays supported by this exact mount configuration.",
      "type": ["integer", "null"],
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "host_attachment_methods": {
      "description": "Published host attachment methods included with this exact stand or arm configuration.",
      "minItems": 1,
      "type": ["array", "null"],
      "items": {
        "type": "string",
        "enum": ["desk_clamp", "grommet", "wall", "freestanding"]
      }
    },
    "min_clamp_thickness_mm": {
      "description": "Published minimum supported desk thickness in mm for the included clamp.",
      "type": ["number", "null"],
      "exclusiveMinimum": 0
    },
    "max_clamp_thickness_mm": {
      "description": "Published maximum supported desk thickness in mm for the included clamp.",
      "type": ["number", "null"],
      "exclusiveMinimum": 0
    },
    "general_product_information": {
      "type": ["object", "null"],
      "description": "General product information and retailer SKUs",
      "properties": {
        "amazon_sku": {
          "type": ["string", "null"],
          "description": "Amazon product SKU"
        },
        "newegg_sku": {
          "type": ["string", "null"],
          "description": "Newegg product SKU"
        },
        "bestbuy_sku": {
          "type": ["number", "null"],
          "description": "Best Buy product SKU"
        },
        "walmart_sku": {
          "type": ["number", "null"],
          "description": "Walmart product SKU"
        },
        "adorama_sku": {
          "type": ["string", "null"],
          "description": "Adorama product SKU"
        },
        "ibuypower_sku": {
          "type": ["string", "null"],
          "description": "iBuyPower product SKU"
        },
        "hyte_sku": {
          "type": ["string", "null"],
          "description": "HYTE product SKU"
        },
        "lttstore_sku": {
          "type": ["string", "null"],
          "description": "LTTStore product SKU"
        },
        "manufacturer_url": {
          "type": ["string", "null"],
          "description": "Official manufacturer product URL"
        }
      }
    },
    "metadata": {
      "type": ["object", "null"],
      "properties": {
        "name": {
          "description": "Full product name",
          "type": ["string", "null"]
        },
        "manufacturer": {
          "description": "Stand manufacturer",
          "type": ["string", "null"]
        },
        "part_numbers": {
          "description": "Array of manufacturer's part numbers/SKUs",
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "series": {
          "description": "Product series name",
          "type": ["string", "null"]
        },
        "variant": {
          "description": "Specific variant in the series",
          "type": ["string", "null"]
        },
        "releaseYear": {
          "description": "Year of release",
          "type": ["number", "null"]
        },
        "last_manually_spec_verified_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "ISO 8601 timestamp of when the part specs were last manually verified by a human"
        }
      },
      "required": ["name"]
    },
    "identifiers": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Monotonically increasing identity snapshot version"
        },
        "identifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["upc", "ean", "gtin", "mpn"]
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "region": {
                "default": "all",
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["type", "value", "region"],
            "additionalProperties": false
          },
          "description": "Canonical product identifiers"
        },
        "retailer_listings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "channel": {
                "type": "string",
                "minLength": 1
              },
              "source_product_id": {
                "type": "string",
                "minLength": 1
              },
              "pricing_enabled": {
                "type": "boolean"
              },
              "excluded_source_offer_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "verified": {
                "type": "boolean"
              }
            },
            "required": ["source", "channel", "source_product_id", "pricing_enabled", "verified"],
            "additionalProperties": false
          },
          "description": "Canonical retailer product listings used for pricing"
        }
      },
      "required": ["version", "identifiers", "retailer_listings"],
      "additionalProperties": false,
      "description": "Current versioned product identity snapshot used for retailer and pricing matching"
    }
  }
}
