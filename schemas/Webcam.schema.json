{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": ["object", "null"],
  "title": "Webcam Schema",
  "description": "Schema for Webcam components",
  "required": ["metadata"],
  "properties": {
    "opendb_id": {
      "type": ["string", "null"],
      "description": "Unique identifier for the document (UUID v4)"
    },
    "weight": {
      "description": "Product weight in grams for one complete, usable unit of this exact variant. Exclude retail packaging, shipping materials, multipack totals, and load capacity. Leave unset when the product is digital, the weight is unknown, or the source does not clearly identify product weight.",
      "type": ["number", "null"],
      "exclusiveMinimum": 0
    },
    "resolution": {
      "description": "Legacy independent resolution preset. Keep for existing rows during migration; enter sourced exact resolution and fps pairs in Capture Modes for new records.",
      "type": ["string", "null"],
      "enum": ["720p", "1080p", "1440p", "2k", "4k", null]
    },
    "resolution_other": {
      "description": "Legacy resolution text for an existing row; it does not prove a capture mode paired with fps.",
      "type": ["string", "null"]
    },
    "frame_rate": {
      "description": "Legacy independent frame-rate preset; do not combine it with resolution into an unsourced mode.",
      "type": ["string", "null"],
      "enum": ["24fps", "30fps", "60fps", "90fps", "120fps", null]
    },
    "frame_rate_other": {
      "description": "Legacy frame-rate text for an existing row; it does not establish an exact resolution/fps pair.",
      "type": ["string", "null"]
    },
    "capture_mode_claims": {
      "description": "Source-backed exact capture resolution and frame-rate pairs for the sold webcam. Enter special prerequisites on their own row; do not combine the legacy resolution and frame-rate presets into invented pairs.",
      "minItems": 1,
      "type": ["array", "null"],
      "items": {
        "description": "One manufacturer-supported capture resolution and frame-rate pair for this exact webcam SKU.",
        "type": "object",
        "properties": {
          "id": {
            "description": "Stable system-assigned row ID; reviewers do not enter this value.",
            "type": ["string", "null"],
            "minLength": 1
          },
          "resolution": {
            "description": "Exact horizontal and vertical captured pixel resolution for this one camera mode.",
            "type": ["object", "null"],
            "properties": {
              "horizontalRes": {
                "description": "Horizontal pixel count for this exact resolution claim; must be a positive integer.",
                "type": ["integer", "null"],
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "verticalRes": {
                "description": "Vertical pixel count for this exact resolution claim; must be a positive integer.",
                "type": ["integer", "null"],
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["horizontalRes", "verticalRes"]
          },
          "frame_rate_fps": {
            "description": "Published frame rate in frames per second paired with this exact resolution.",
            "type": ["number", "null"],
            "exclusiveMinimum": 0
          },
          "claim": {
            "description": "Use supported for a listed capture mode; use maximum_at_resolution only for an explicitly stated maximum at this exact resolution.",
            "type": ["string", "null"],
            "enum": ["supported", "maximum_at_resolution", null]
          },
          "conditions": {
            "description": "Official prerequisite or restriction for this exact capture mode, such as USB version, codec, HDR setting, or application. This note is not a filter or compatibility rule.",
            "type": ["string", "null"],
            "minLength": 1
          }
        },
        "required": ["resolution", "frame_rate_fps", "claim"]
      }
    },
    "connectivity_type": {
      "description": "Webcam connectivity interface types",
      "type": ["array", "null"],
      "items": {
        "type": "string",
        "enum": ["Wired", "Wired USB-A", "Wired USB-C", "Wireless 2.4GHz", "Bluetooth"]
      }
    },
    "lighting": {
      "description": "Lighting capabilities for this product. Use RGB for non-addressable RGB, ARGB for addressable RGB, Multicolor for non-RGB multi-color lighting, Fixed for a single fixed lighting color, None when the product has no lighting, Display for configurable displays, and Fixed Color Display for displays limited to fixed colors such as black and white.",
      "type": ["array", "null"],
      "items": {
        "type": "string",
        "enum": ["RGB", "ARGB", "Multicolor", "Fixed", "None", "Display", "Fixed Color Display"]
      }
    },
    "general_product_information": {
      "type": ["object", "null"],
      "description": "General product information and retailer SKUs",
      "properties": {
        "amazon_sku": {
          "type": ["string", "null"],
          "description": "Amazon product SKU"
        },
        "newegg_sku": {
          "type": ["string", "null"],
          "description": "Newegg product SKU"
        },
        "bestbuy_sku": {
          "type": ["number", "null"],
          "description": "Best Buy product SKU"
        },
        "walmart_sku": {
          "type": ["number", "null"],
          "description": "Walmart product SKU"
        },
        "adorama_sku": {
          "type": ["string", "null"],
          "description": "Adorama product SKU"
        },
        "ibuypower_sku": {
          "type": ["string", "null"],
          "description": "iBuyPower product SKU"
        },
        "hyte_sku": {
          "type": ["string", "null"],
          "description": "HYTE product SKU"
        },
        "lttstore_sku": {
          "type": ["string", "null"],
          "description": "LTTStore product SKU"
        },
        "manufacturer_url": {
          "type": ["string", "null"],
          "description": "Official manufacturer product URL"
        }
      }
    },
    "metadata": {
      "type": ["object", "null"],
      "properties": {
        "name": {
          "description": "Full product name",
          "type": ["string", "null"]
        },
        "manufacturer": {
          "description": "Webcam manufacturer",
          "type": ["string", "null"]
        },
        "part_numbers": {
          "description": "Array of manufacturer's part numbers/SKUs",
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "series": {
          "description": "Product series name",
          "type": ["string", "null"]
        },
        "variant": {
          "description": "Specific variant in the series",
          "type": ["string", "null"]
        },
        "releaseYear": {
          "description": "Year of release",
          "type": ["number", "null"]
        },
        "last_manually_spec_verified_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "ISO 8601 timestamp of when the part specs were last manually verified by a human"
        }
      },
      "required": ["name"]
    },
    "identifiers": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Monotonically increasing identity snapshot version"
        },
        "identifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["upc", "ean", "gtin", "mpn"]
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "region": {
                "default": "all",
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["type", "value", "region"],
            "additionalProperties": false
          },
          "description": "Canonical product identifiers"
        },
        "retailer_listings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "channel": {
                "type": "string",
                "minLength": 1
              },
              "source_product_id": {
                "type": "string",
                "minLength": 1
              },
              "pricing_enabled": {
                "type": "boolean"
              },
              "excluded_source_offer_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "verified": {
                "type": "boolean"
              }
            },
            "required": ["source", "channel", "source_product_id", "pricing_enabled", "verified"],
            "additionalProperties": false
          },
          "description": "Canonical retailer product listings used for pricing"
        }
      },
      "required": ["version", "identifiers", "retailer_listings"],
      "additionalProperties": false,
      "description": "Current versioned product identity snapshot used for retailer and pricing matching"
    }
  }
}
